# Искра — шаблон переменных окружения.
#
# Как использовать:
#   1. cp .env.example .env.local
#   2. Заполнить значения локально (или задать их в панели хостинга).
#
# Правила:
#   • значения ниже НАМЕРЕННО пустые — здесь нет и не должно быть реальных ключей;
#   • .env.local и любые .env.* (кроме .env.example) не попадают в Git;
#   • секреты хранятся только в окружении разработчика или хостинга;
#   • ключ Gemini читается исключительно на сервере (Route Handler / Server Action),
#     никогда не попадает в клиентский бандл и не логируется.

# Ключ Google AI Studio для Gemini API (серверная переменная, без префикса NEXT_PUBLIC_).
GEMINI_API_KEY=

# Идентификатор модели Gemini. Пусто → gemini-3.5-flash-lite.
# Другое значение задаётся только после согласования с PM.
GEMINI_MODEL=
